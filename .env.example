# Recruiting AI Guide — environment variables
# Copy to .env.local for local dev. Set in Vercel (or your host) for prod.

# Lemon Squeezy product checkout URL for THIS guide (a separate LS product from
# the voice-agents guide — do not reuse that checkout link).
# Found in Lemon Squeezy → Products → [this product] → Share → Buy Link.
# Example: https://digitalbound.lemonsqueezy.com/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_CHECKOUT_URL=

# Endpoint for free-preview email captures (ConvertKit / Beehiiv / Loops / your
# own serverless function). Leave blank to save emails to localStorage only.
VITE_EMAIL_CAPTURE_URL=

# Price string shown on the Buy CTA and paywall modal, e.g. "147". Leave blank
# until the price is decided — the UI falls back to "Get the Guide" / "Price
# coming soon" with no number shown.
VITE_PRICE_DISPLAY=

# Lemon Squeezy success-URL token. When a buyer returns from checkout the URL
# will include ?purchased=<this-value> and the app unlocks paid content + PDF
# export. Set this to the same string in the Lemon Squeezy success-URL redirect
# for THIS product. Must be a different value from the voice-agents guide's
# token if both apps ever share a domain.
VITE_PURCHASE_TOKEN=

# Plausible domain (optional). Leave blank to disable analytics.
VITE_PLAUSIBLE_DOMAIN=
